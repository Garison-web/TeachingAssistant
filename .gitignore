# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# Backend secrets & generated files — never commit
backend/.env
backend/chroma_store/
backend/uploads/
backend/teaching_assistant.db
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/*.pyc

# Dev server logs
expo.log
backend.log

# typescript
*.tsbuildinfo

# generated native folders
/ios
/android
