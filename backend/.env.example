# ── Copy this file to .env and fill in real values ──────────────────────────
# Never commit .env to version control.

# Groq API key (required for chat, flashcards, quiz, and notes)
# Get one free at https://console.groq.com
GROQ_API_KEY=gsk_...

# Groq model to use (default is llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# SQLite database file location
DB_PATH=./teaching_assistant.db

# ChromaDB persistent storage path
CHROMA_DB_PATH=./chroma_store

# Whisper model size: tiny | base | small | medium | large
WHISPER_MODEL_SIZE=base

# File upload directory
UPLOAD_DIR=./uploads

# CORS — add your production frontend URL when deploying
FRONTEND_URL=http://localhost:19006
